POSTGRES_DB=banxia
POSTGRES_USER=banxia
POSTGRES_PASSWORD=banxia-local
POSTGRES_PORT=5432

CLICKHOUSE_DB=banxia
CLICKHOUSE_USER=banxia
CLICKHOUSE_PASSWORD=banxia-local
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

REDIS_PASSWORD=banxia-local
REDIS_PORT=6379

MINIO_ROOT_USER=banxia
MINIO_ROOT_PASSWORD=banxia-local-secret
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9001

KAFKA_PORT=29092
FLINK_WEB_PORT=8081
PROMETHEUS_PORT=9090
# Local development override; omit on ECS to use Compose's host port 80 default.
BANXIA_API_PORT=8765
BANXIA_API_TOKEN=
BANXIA_WATCH_DATE=
BANXIA_REPORT_DATE=
BANXIA_REPORT_SCHEDULE=16:30,23:30
BANXIA_REFERENCE_SYNC_SCHEDULE=16:20

# CLI compatibility mode; Compose application services enforce required mode.
BANXIA_STORAGE_MODE=off
BANXIA_POSTGRES_DSN=postgresql://banxia:banxia-local@127.0.0.1:5432/banxia
BANXIA_CLICKHOUSE_HOST=127.0.0.1
BANXIA_CLICKHOUSE_PORT=8123
BANXIA_CLICKHOUSE_DATABASE=banxia
BANXIA_CLICKHOUSE_USER=banxia
BANXIA_CLICKHOUSE_PASSWORD=banxia-local
BANXIA_REDIS_URL=redis://:banxia-local@127.0.0.1:6379/0
BANXIA_MINIO_ENDPOINT=127.0.0.1:9002
BANXIA_MINIO_ACCESS_KEY=banxia
BANXIA_MINIO_SECRET_KEY=banxia-local-secret
BANXIA_MINIO_SECURE=false
BANXIA_MINIO_REPORT_BUCKET=strategy-reports
BANXIA_MINIO_MARKET_BUCKET=market-raw
BANXIA_STRATEGY_VERSION=v2
BANXIA_CODE_COMMIT=unknown
BANXIA_METRICS_PORT=9100
BANXIA_MONITOR_SNAPSHOT_TTL_SECONDS=172800
BANXIA_WRITER_QUEUE_SIZE=1024
BANXIA_WRITER_BATCH_SIZE=32
